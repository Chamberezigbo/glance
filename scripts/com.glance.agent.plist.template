<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.glance.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/bin/glance.app/Contents/MacOS/glance</string>
  </array>

  <!-- Start at login and sit idle. The daemon costs nothing until the hotkey
       is pressed: no polling, no capture, no microphone. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Menu-bar UI needs the user's GUI session, not a background context. -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <!-- Logs live in ~/.glance, never in the repo.
       macOS protects ~/Documents, ~/Desktop and ~/Downloads under TCC, and
       launchd has no permission to write there. If the repo is cloned into one
       of them, launchd cannot open the log file and the job fails to spawn
       entirely — exit 78, EX_CONFIG, with an empty log for the same reason it
       failed. The app itself is fine; it never gets started. -->
  <key>StandardOutPath</key>
  <string>__LOGS__/agent.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/agent.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
