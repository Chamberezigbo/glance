#!/usr/bin/env bash
# Launched by the menu-bar daemon.
#   ./bin/glance-run                 -> ask out loud
#   ./bin/glance-run --ask "..."     -> ask with a typed question
#   ./bin/glance-run --greet         -> speak the login/unlock greeting
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# launchd gives us a minimal PATH, so find node the way the user's shell would.
export PATH="$HOME/.nvm/versions/node/$(ls "$HOME/.nvm/versions/node" 2>/dev/null | sort -V | tail -1)/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

case "${1:-}" in
  --greet)  exec node dist/cli.js greet  >> "$ROOT/glance.log" 2>&1 ;;
  --repeat) exec node dist/cli.js repeat >> "$ROOT/glance.log" 2>&1 ;;
  --next)   exec node dist/cli.js next   >> "$ROOT/glance.log" 2>&1 ;;
  --task-clear) exec node dist/cli.js task clear >> "$ROOT/glance.log" 2>&1 ;;
  --task)   exec node dist/cli.js task   >> "$ROOT/glance.log" 2>&1 ;;
  --ask)   [ -n "${2:-}" ] && exec node dist/cli.js --speak "$2" >> "$ROOT/glance.log" 2>&1 ;;
esac
exec node dist/cli.js --listen >> "$ROOT/glance.log" 2>&1
